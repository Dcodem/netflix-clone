{
  "framework": null,
  "installCommand": "npm --prefix frontend install",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "ignoreCommand": "[ \"$VERCEL_PROJECT_ID\" = \"prj_jl13z9YWovLshbQwiJHVq7e9TuKM\" ]",
  "env": {
    "TMDB_API_KEY": "1dd1c4a1a9ac111f790158c69f59b620",
    "VITE_TMDB_API_KEY": "1dd1c4a1a9ac111f790158c69f59b620",
    "CATALOG_UPSTREAM": "https://stationery-guest-namely-dealers.trycloudflare.com"
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "cursor/*": false,
      "cursor/mylist-sort-captions-a7c7": true,
      "cursor/title-modal-legal-a7c7": true,
      "cursor/tmdb-trailers-a7c7": true,
      "cursor/tmdb-title-enrich-a7c7": true,
      "cursor/vercel-hover-trailers-a7c7": true,
      "cursor/embed-tmdb-key-a7c7": true
    }
  },
  "functions": {
    "api/catalog.js": {
      "includeFiles": "mock/**"
    },
    "api/tmdb.js": {
      "includeFiles": "frontend/src/config/tmdbKey.js"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/catalog?__p=/health" },
    { "source": "/movies", "destination": "/api/catalog?__p=/movies" },
    { "source": "/movies/:id*", "destination": "/api/catalog?__p=/movies/:id*" },
    { "source": "/shows/:id*", "destination": "/api/catalog?__p=/shows/:id*" },
    { "source": "/catalog/:kind*", "destination": "/api/catalog?__p=/catalog/:kind*" },
    { "source": "/watch/:path*", "destination": "/api/catalog?__p=/watch/:path*" },
    { "source": "/img", "destination": "/api/catalog?__p=/img" },
    { "source": "/art/:path*", "destination": "/api/catalog?__p=/art/:path*" },
    { "source": "/tmdb/:path*", "destination": "/api/tmdb?__p=/:path*" },
    { "source": "/iva/:path*", "destination": "/api/iva?__p=/:path*" },
    {
      "source": "/search",
      "has": [{ "type": "header", "key": "accept", "value": "(?i).*text/html.*" }],
      "destination": "/index.html"
    },
    { "source": "/search", "destination": "/api/catalog?__p=/search" },
    { "source": "/trending/:path*", "destination": "/api/catalog?__p=/trending/:path*" },
    { "source": "/rails", "destination": "/api/catalog?__p=/rails" },
    { "source": "/stream/:path*", "destination": "/api/catalog?__p=/stream/:path*" },
    { "source": "/similar/:path*", "destination": "/api/catalog?__p=/similar/:path*" },
    { "source": "/media", "destination": "/api/catalog?__p=/media" },
    { "source": "/browse", "destination": "/index.html" },
    { "source": "/browse/:path*", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/taste", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/help", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/gift", "destination": "/index.html" },
    { "source": "/speed", "destination": "/index.html" },
    { "source": "/ways", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/legal", "destination": "/index.html" },
    { "source": "/corporate", "destination": "/index.html" },
    { "source": "/investors", "destination": "/index.html" },
    { "source": "/jobs", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/media", "destination": "/index.html" },
    { "source": "/tv", "destination": "/index.html" },
    { "source": "/movie/:path*", "destination": "/index.html" },
    { "source": "/show/:path*", "destination": "/index.html" }
  ]
}
