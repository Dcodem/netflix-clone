# Copy to .env.local in this folder and restart `npm run dev`.
# Do not commit .env.local. You can also paste keys on the Account screen.

# Catalog API the Vite dev proxy forwards to (default http://localhost:8090).
VITE_API_ORIGIN=http://localhost:8090

# Fetch prefix. Leave empty while using the Vite proxy or when the UI is
# served from the same origin as the catalog. For a split production host,
# set this to the catalog origin (no trailing slash), e.g. https://catalog.example.com
VITE_API_BASE=

# If watch_href values are relative (/watch/...), set the origin of the video site.
# Absolute watch_href URLs are used as-is.
VITE_PLAYER_ORIGIN=

# TMDB is the default (free). IVA is optional paid extras — leave it blank.
VITE_TMDB_API_KEY=
VITE_IVA_API_KEY=
